# ---------------------------------------------------------------------------
# Local development defaults. Copy this file to .env and fill in real
# values. NEVER commit the real .env (it's already in .gitignore).
#
# For PRODUCTION, don't edit this file — instead set these same variable
# names as real environment variables on your host (Docker/Render/Railway/
# EC2/etc). Suggested production values are shown in the comments below.
# ---------------------------------------------------------------------------

# Generate a fresh one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=uOrzMu+wYLIDtnUgOxd30thE+D$1ci2Y(PTCn3l7&^*8b)Bq8F

# Production: DJANGO_DEBUG=False
DJANGO_DEBUG=True

# Production: DJANGO_ALLOWED_HOSTS=api.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production: CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://192.168.1.8:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://192.168.1.8:8080

# PostgreSQL — use your managed DB host/credentials in production.
DB_NAME=vibe_tracker
DB_USER=postgres
DB_PASSWORD=raj18
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Email — leave EMAIL_HOST/USER/PASSWORD blank locally and invitation emails
# will just print to the console instead of actually sending. Fill these in
# (in production env vars, not this file) to send real emails.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=rajbrijeshsingh1804@gmail.com
EMAIL_HOST_PASSWORD=wwrc htgh fhrb nmhk
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=rajbrijeshsingh1804@gmail.com

# OPTIONAL. Invite links now auto-detect your live frontend domain from the
# inviting browser's Origin header, as long as that domain is listed in
# CORS_ALLOWED_ORIGINS below — so you generally do NOT need to set this in
# production anymore. It's only used as a fallback when an invite is
# created outside a browser (management command/script) with no Origin
# header to read.
FRONTEND_ACCEPT_INVITE_URL=http://192.168.1.8:8080/accept-invite


# How many days an invitation link stays valid before expiring.
INVITATION_EXPIRY_DAYS=7

